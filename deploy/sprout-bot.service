# Copy to /etc/systemd/system/sprout-bot.service (User and paths are for the Pi,
# change them if yours differ). Start it only once `seed` or `adopt` has made
# a tree: without one the bot exits 1 and systemd restarts it every minute.
# sudo systemctl daemon-reload && sudo systemctl enable --now sprout-bot
[Unit]
Description=Sprout, the Bluesky tree bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reiberry
WorkingDirectory=/home/reiberry/personal/sprout
ExecStart=/home/reiberry/personal/sprout/.venv/bin/python -m sprout run
Restart=on-failure
RestartSec=60
# 78 means Bluesky refused the handle or app password: retrying would only
# burn through the daily login limit, so wait for someone to fix .env.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target

# Copy to /etc/systemd/system/sprout.service, fix User and the two paths,
# then: sudo systemctl daemon-reload && sudo systemctl enable --now sprout
[Unit]
Description=Sprout, the Bluesky tree bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-services/sprout
ExecStart=/home/pi/pi-services/sprout/.venv/bin/python -m sprout run
Restart=on-failure
RestartSec=60
# 78 means Bluesky refused the handle or app password: retrying would only
# burn through the daily login limit, so wait for someone to fix .env.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target

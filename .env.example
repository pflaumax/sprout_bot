# The account the bot posts from, and an app password for it
# (Bluesky: Settings → Privacy and security → App passwords).
# Never put the account's main password here.
BSKY_HANDLE=your-bot.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional. The values below are the defaults.
# SPROUT_DATA=./data                 # database, saved session, previews
# SPROUT_POLL_SECONDS=30             # how often to read notifications
# SPROUT_BATCH=10                    # post an update after this many new things...
# SPROUT_MIN_GAP_MINUTES=10          # ...but no sooner than this after the last post...
# SPROUT_MAX_WAIT_MINUTES=60         # ...and never sit on a smaller batch longer than this
# SPROUT_UPDATE_AVATAR=1             # the bot's avatar shows the current tree
# SPROUT_MENTION_LEADER=1            # tag whoever's branch just became the biggest
